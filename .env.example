# انسخه باسم .env (أو حطها كـ Environment Variables على الاستضافة)
PORT=4000
NODE_ENV=production

# أول أدمن (بيتعمل مرة واحدة عند أول تشغيل). لو سبت الباسورد فاضي هيتولّد وينطبع في الـ console
ADMIN_EMAIL=admin@egylux.com
ADMIN_PASSWORD=

# دومين الموقع (للـ canonical / sitemap / روابط الإيميل)
# SITE_URL=https://www.egylux.com

# مكان قاعدة البيانات والصور المرفوعة — لازم يكون على disk دايم
DATA_DIR=server/data

# (اختياري) SMTP — أو اضبطه من الداش بورد: Settings & email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# (اختياري) ثابت لتوقيع الجلسات. لو فاضي بيتولّد ويتخزن في DATA_DIR
JWT_SECRET=
# فرق التوقيت لتقارير الأيام (مصر = 2)
TZ_OFFSET_HOURS=2
